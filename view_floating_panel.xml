<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_root"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PRO SIGNAL AI"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_close_panel"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Close Panel" />
    </LinearLayout>

    <!-- Detected Pair and Timeframe -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_detected_pair"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="EUR/USD OTC"
            android:textColor="@color/cyan_accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_detected_timeframe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1M"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Main Signal Verdict Card -->
    <LinearLayout
        android:id="@+id/layout_verdict_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#1E293B"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_signal_verdict"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="READY TO SCAN"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_confidence_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tap SCAN CURRENT CHART below"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Analysis Explanation -->
    <TextView
        android:id="@+id/tv_analysis_explanation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Chart has not been scanned yet. Center Quotex on your screen and tap scan."
        android:textColor="#CBD5E1"
        android:textSize="11sp"
        android:lineSpacingExtra="2dp" />

    <TextView
        android:id="@+id/tv_timestamp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Timestamp: --:--:--"
        android:textColor="#64748B"
        android:textSize="9sp" />

    <!-- Action Buttons -->
    <Button
        android:id="@+id/btn_scan_current_chart"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/cyan_accent"
        android:text="SCAN CURRENT CHART"
        android:textColor="#0B0F19"
        android:textStyle="bold"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_rescan"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#334155"
            android:text="RESCAN"
            android:textColor="@color/white"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_stop_scanner_overlay"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:backgroundTint="#334155"
            android:text="STOP SCANNER"
            android:textColor="#EF4444"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Safety Disclaimer -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Informational analysis only. Never auto-trades."
        android:textColor="#64748B"
        android:textSize="9sp" />

</LinearLayout>
